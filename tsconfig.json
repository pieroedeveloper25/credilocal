{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src",
    "vite.config.ts"
  ],
  "exclude": [
    "src/infraestructura/http",
    "src/infraestructura/persistencia/sqlite.ts",
    "src/infraestructura/demostracion/crearDatosDemo.ts",
    "src/contexts/identity-and-access/infraestructura/sesiones.ts"
  ]
}
